# DM26-0838

# The package version is deliberately NOT declared here. It comes from the
# <revision> property in osate-cli/pom.xml, which Maven bakes into osate-cli.jar;
# the packaging scripts read it back out of the jar they are packaging.
OSATE_CLI_PACKAGE_NAME="osate-cli"
OSATE_CLI_DESCRIPTION="OSATE command-line interface for AADL workspaces"
OSATE_CLI_MAINTAINER_EMAIL="info@osate.org"
OSATE_CLI_VENDOR="CMU/SEI"
OSATE_CLI_LICENSE="LicenseRef-BSD-SEI"
OSATE_CLI_HOMEPAGE="https://github.com/osate/aadl-tooling"
TEMURIN_FEATURE_VERSION="21"
