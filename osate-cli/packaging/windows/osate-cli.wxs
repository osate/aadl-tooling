<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Keep this UpgradeCode stable across releases and architectures. -->
  <Package Name="osate-cli" Manufacturer="$(var.Vendor)" Version="$(var.Version)"
           UpgradeCode="ECA9F49D-D2CD-4B39-9F83-90D11533219A"
           Scope="perMachine" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of osate-cli is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.Homepage)" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM"
                      Key="Software\OSATE\osate-cli" Name="InstallDir"
                      Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]"
                 Before="CostFinalize" Sequence="both"
                 Condition="NOT INSTALLFOLDER AND PREVIOUSINSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="osate-cli">
        <Component Id="InstallLocation">
          <RegistryValue Root="HKLM" Key="Software\OSATE\osate-cli"
                         Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>
        <Directory Id="BinFolder" Name="bin">
          <Component Id="Launcher">
            <File Source="!(bindpath.Payload)\bin\osate-cli.bat" KeyPath="yes" />
            <!-- Windows Installer appends and removes just this PATH entry. -->
            <Environment Id="CliPath" Name="PATH" Value="[BinFolder]"
                         Action="set" Part="last" System="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Payload)\**">
        <Exclude Files="!(bindpath.Payload)\bin\osate-cli.bat" />
      </Files>
    </ComponentGroup>
    <Feature Id="Complete" Title="osate-cli" Level="1">
      <ComponentRef Id="Launcher" />
      <ComponentRef Id="InstallLocation" />
      <ComponentGroupRef Id="Payload" />
    </Feature>
  </Package>
</Wix>
