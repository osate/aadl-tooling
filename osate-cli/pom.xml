<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.osate</groupId>
	<artifactId>osate-cli-parent</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>

	<modules>
		<module>osate-workspace-server</module>
		<module>osate-cli</module>
		<module>dist</module>
	</modules>

	<properties>
		<!-- The single place where the osate-cli release version is specified.
		     It flows to: the Maven artifact versions, the version.properties
		     resource in osate-cli.jar (reported by 'osate-cli -v' and 'help'),
		     and - because packaging/scripts read it back out of the built jar -
		     the tarball, deb, rpm, and Homebrew package versions.
		     Keep it a plain release version: rpm forbids '-' in Version, so a
		     '-SNAPSHOT' suffix would not survive packaging. -->
		<revision>0.1.0</revision>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<gson.version>2.11.0</gson.version>
		<junit.version>5.11.3</junit.version>
	</properties>

	<build>
		<plugins>
			<!-- Replaces ${revision} with its literal value in installed/deployed
			     poms. Harmless for the documented 'package'/'verify' flows. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.6.0</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten-clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
