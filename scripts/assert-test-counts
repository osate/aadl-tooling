# Asserts that the suites that matter actually executed.
#
# A green build does not prove they did. The integration suites are @EnabledIf-
# gated on system properties that point into the built dist layout, so an
# incomplete layout makes them vanish silently rather than fail. The
# language-server suite is restricted to AllTests, which would report zero tests
# if that class were ever dropped from the includes.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
skip_cli=false

usage() {
	cat <<'EOF'
Usage: scripts/assert-test-counts [--skip-cli]

Fails if any required test suite reported zero executed tests.

Options:
  --skip-cli   Only check the language-server suite. Use when the osate-cli
               reactor was not built.
  -h, --help   Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--skip-cli)
		skip_cli=true
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "Unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

failures=0

# Reads the tests/skipped attributes from a surefire or failsafe report and
# requires at least one test to have actually run.
assert_suite() {
	label="$1"
	report="${repo_root}/$2"

	if [[ ! -f "${report}" ]]; then
		echo "MISSING  ${label}" >&2
		echo "         expected report at $2" >&2
		failures=$((failures + 1))
		return
	fi

	tests=$(sed -n 's/.*[^[:alnum:]]tests="\([0-9]*\)".*/\1/p' "${report}" | head -n 1)
	skipped=$(sed -n 's/.*[^[:alnum:]]skipped="\([0-9]*\)".*/\1/p' "${report}" | head -n 1)
	tests=${tests:-0}
	skipped=${skipped:-0}
	ran=$((tests - skipped))

	if [[ "${ran}" -lt 1 ]]; then
		echo "NOT RUN  ${label}" >&2
		echo "         ${tests} declared, ${skipped} skipped, ${ran} executed in $2" >&2
		failures=$((failures + 1))
		return
	fi

	printf 'ok       %-28s %s executed\n' "${label}" "${ran}"
}

assert_suite "language server AllTests" \
	"aadl-language-server/plugins/org.osate.aadl.ls.tests/target/surefire-reports/TEST-org.osate.aadl.ls.tests.AllTests.xml"

if [[ "${skip_cli}" == false ]]; then
	assert_suite "workspace server EndToEndIT" \
		"osate-cli/osate-workspace-server/target/failsafe-reports/TEST-org.osate.cli.server.EndToEndIT.xml"
	assert_suite "assembled CLI CliEndToEndIT" \
		"osate-cli/dist/target/failsafe-reports/TEST-org.osate.cli.dist.CliEndToEndIT.xml"
	assert_suite "CLI ArgParserTest" \
		"osate-cli/osate-cli/target/surefire-reports/TEST-org.osate.cli.ArgParserTest.xml"
	assert_suite "CLI VersionTest" \
		"osate-cli/osate-cli/target/surefire-reports/TEST-org.osate.cli.VersionTest.xml"
fi

if [[ "${failures}" -gt 0 ]]; then
	echo >&2
	echo "${failures} required test suite(s) did not execute." >&2
	exit 1
fi

echo "All required test suites executed."
