# files ("Third Party Software"). The Third Party Software that is used by this program is dependent upon your system
# configuration. By using this program, You agree to comply with any and all relevant Third Party Software terms and
# conditions contained in any such Third Party Software or separate license file distributed with such Third Party
# Software. The parties who own the Third Party Software ("Third Party Licensors") are intended third party beneficiaries
# to this license with respect to the terms applicable to their Third Party Software. Third Party Software licenses
# only apply to the Third Party Software and not any other portion of this program or this program as a whole.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
osate_dir="${repo_root}/osate2"
osate_repo_dir="${osate_dir}/releng/org.osate.build.repository/target/repository"
osate_main_pom="${osate_dir}/releng/org.osate.build.main/pom.xml"
plugins_dir="${repo_root}/aadl-language-server/releng/org.osate.aadl.ls.repository/target/repository/plugins"
extension_dir="${repo_root}/vscode-extension"
provenance_dir="${repo_root}/target"

skip_osate=false
skip_extension=false
skip_extension_tests=false
skip_cli=false
extension_pre_release=false

usage() {
	cat <<'EOF'
Usage: scripts/build-test-release [options]

Builds OSATE, the language server, the VS Code extension, and the CLI, then
validates the packaged runtimes and writes target/build-provenance.properties.

Options:
  --skip-osate             Reuse an existing OSATE build instead of rebuilding
                           it. Requires the OSATE p2 repository and the
                           osate2-platform target artifact to be present; both
                           are verified before the remaining phases run. Intended
                           for CI, where the OSATE output is restored from a
                           cache keyed on the osate2 submodule commit.
  --skip-extension         Do not build the VS Code extension. Implies
                           --skip-extension-tests.
  --skip-extension-tests   Skip the VS Code extension test suite. The
                           integration tests download VS Code and need a
                           display, which is not always available.
  --skip-cli               Do not build the osate-cli reactor.
  --extension-pre-release  Mark the VSIX as a pre-release. vsce writes this into
                           the package manifest and refuses to publish a package
                           as a pre-release unless it was built as one, so this
                           has to be decided at build time.
  -h, --help               Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--skip-osate)
		skip_osate=true
		;;
	--skip-extension)
		skip_extension=true
		skip_extension_tests=true
		;;
	--skip-extension-tests)
		skip_extension_tests=true
		;;
	--skip-cli)
		skip_cli=true
		;;
	--extension-pre-release)
		extension_pre_release=true
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "Unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

git -C "${repo_root}" submodule update --init osate2

expected_osate_sha=$(git -C "${repo_root}" ls-files --stage osate2 | awk '$1 == "160000" { print $2 }')
actual_osate_sha=$(git -C "${osate_dir}" rev-parse HEAD)

if [[ -z "${expected_osate_sha}" || "${actual_osate_sha}" != "${expected_osate_sha}" ]]; then
	echo "OSATE submodule mismatch." >&2
	echo "Expected: ${expected_osate_sha:-<missing gitlink>}" >&2
	echo "Actual:   ${actual_osate_sha}" >&2
	exit 1
fi

if [[ -n $(git -C "${osate_dir}" status --porcelain) ]]; then
	echo "OSATE submodule has uncommitted changes." >&2
	exit 1
fi

# Recorded before anything is built, so it describes the sources that went in.
# The superproject is allowed to be dirty during development, unlike the
# submodule, so mark it rather than refusing: a commit alone would otherwise
# claim to identify code that is not what was compiled.
tooling_commit=$(git -C "${repo_root}" rev-parse HEAD)
if [[ -n $(git -C "${repo_root}" status --porcelain) ]]; then
	tooling_commit="${tooling_commit}-dirty"
fi

osate_version=$(sed -n 's#.*<osate\.version>\(.*\)</osate\.version>.*#\1#p' \
	"${osate_main_pom}" | head -n 1)
if [[ -z "${osate_version}" ]]; then
	echo "Could not read <osate.version> from:" >&2
	echo "  ${osate_main_pom}" >&2
	echo "The OSATE build layout changed; update this script." >&2
	exit 1
fi

if [[ "${skip_osate}" == true ]]; then
	echo "Reusing existing OSATE build"

	# The language server resolves OSATE through two independent mechanisms, and
	# --skip-osate has to satisfy both: the p2 repository comes from the
	# filesystem, while the target definition comes from the Maven local
	# repository. Check them here so a stale or partial cache fails with an
	# actionable message instead of a Tycho resolution error.
	if [[ ! -f "${osate_repo_dir}/artifacts.jar" ]]; then
		echo "OSATE p2 repository not found at:" >&2
		echo "  ${osate_repo_dir}" >&2
		echo "Run without --skip-osate to build it." >&2
		exit 1
	fi

	# -N keeps this to the aggregator pom; resolving the modules would need the
	# very OSATE artifacts this check is about to look for.
	local_repo=$(mvn -q -N -f "${repo_root}/pom.xml" help:evaluate \
		-Dexpression=settings.localRepository -DforceStdout)
	osate_platform_dir="${local_repo}/org/osate/osate2-platform/${osate_version}"
	if ! compgen -G "${osate_platform_dir}/*.target" >/dev/null; then
		echo "OSATE target definition org.osate:osate2-platform:${osate_version} is not installed at:" >&2
		echo "  ${osate_platform_dir}" >&2
		echo "The language-server reactor resolves it from the Maven local repository," >&2
		echo "so the OSATE build must run with 'install'. Run without --skip-osate." >&2
		exit 1
	fi
else
	echo "Building OSATE"

	mvn \
		-T6 \
		-f "${osate_dir}/pom.xml" \
		-s "${osate_dir}/releng/osate.releng/settings.xml" \
		-Plocal \
		-Dpr.build=false \
		-Dtycho.localArtifacts=ignore \
		-Dsign=false \
		-Dspotbugs=false \
		-Dcodecoverage=false \
		-Djavadoc=false \
		-DfailIfNoTests=false \
		clean install
fi

echo "Building language server"

# Two invocations, not one root-reactor build: the extension consumes the server
# plug-ins through the server/aadl/lib symlink, which Maven cannot see, so a
# parallel reactor is free to package the VSIX before those plug-ins exist.
mvn \
	-T6 \
	-f "${repo_root}/aadl-language-server/pom.xml" \
	-Dtycho.localArtifacts=ignore \
	clean verify

if [[ "${skip_extension}" == true ]]; then
	echo "Skipping VS Code extension"
else
	extension_args=()
	if [[ "${extension_pre_release}" == true ]]; then
		echo "Building VS Code extension (pre-release)"
		extension_args+=(-Dvsce.package.script=package:pre-release)
	else
		echo "Building VS Code extension"
	fi

	mvn \
		-T6 \
		-f "${repo_root}/vscode-extension/pom.xml" \
		-Dtycho.localArtifacts=ignore \
		"${extension_args[@]+"${extension_args[@]}"}" \
		clean verify
fi

if [[ "${skip_extension_tests}" == true ]]; then
	echo "Skipping VS Code extension tests"
else
	echo "Testing VS Code extension"

	# The Maven reactor only runs npm install/compile/package for the extension,
	# so its own suites have to be invoked explicitly. Prefer the Node that
	# frontend-maven-plugin just installed so the version matches the build.
	extension_path="${PATH}"
	if [[ -d "${extension_dir}/node" ]]; then
		extension_path="${extension_dir}/node:${PATH}"
	fi

	# The integration tests launch a real VS Code, which needs a display.
	(
		cd "${extension_dir}"
		export PATH="${extension_path}"
		if [[ "$(uname -s)" == "Linux" && -z "${DISPLAY:-}" ]]; then
			xvfb-run -a npm test
		else
			npm test
		fi
	)
fi

if [[ "${skip_cli}" == true ]]; then
	echo "Skipping OSATE CLI"
else
	echo "Building OSATE CLI"

	# The language-server bundle version is only knowable after its build, and the
	# osate2 gitlink is only knowable here, so the CLI reactor cannot derive either
	# on its own. The underscore in the glob keeps org.osate.aadl.ls.tests out.
	ls_bundle=$(find "${plugins_dir}" -name 'org.osate.aadl.ls_*.jar' -exec basename {} \; | head -n 1)
	ls_version=${ls_bundle#org.osate.aadl.ls_}
	ls_version=${ls_version%.jar}
	if [[ -z "${ls_version}" ]]; then
		echo "Could not determine the language-server bundle version from:" >&2
		echo "  ${plugins_dir}" >&2
		exit 1
	fi

	mvn \
		-T6 \
		-f "${repo_root}/osate-cli/pom.xml" \
		-Daadl.ls.version="${ls_version}" \
		-Daadl.ls.commit="${tooling_commit}" \
		-Dosate.version="${osate_version}" \
		-Dosate.commit="${expected_osate_sha}" \
		verify
fi

duplicate_bundles=$(
	find "${plugins_dir}" -type f -name '*.jar' |
		sed -E 's#^.*/##; s/_[0-9].*$//' |
		sort |
		uniq -c |
		awk '$1 > 1 && $2 != "org.antlr.runtime" { print }'
)

if [[ -n "${duplicate_bundles}" ]]; then
	echo "Unexpected duplicate bundle versions in the language-server repository:" >&2
	echo "${duplicate_bundles}" >&2
	exit 1
fi

antlr_osgi_count=$(find "${plugins_dir}" -type f -name 'org.antlr.runtime_*.jar' | wc -l | tr -d ' ')
antlr3_count=$(find "${plugins_dir}" -type f -name 'org.antlr.runtime_3*.jar' | wc -l | tr -d ' ')
antlr44_count=$(find "${plugins_dir}" -type f -name 'antlr-runtime-4.4.jar' | wc -l | tr -d ' ')
if [[ "${antlr_osgi_count}" != "2" || "${antlr3_count}" != "1" || "${antlr44_count}" != "1" ]]; then
	echo "Expected two org.antlr.runtime bundles, including one 3.x bundle, and one antlr-runtime-4.4.jar;" >&2
	echo "found ${antlr_osgi_count}, ${antlr3_count}, and ${antlr44_count}." >&2
	exit 1
fi

tooling_version=$(mvn -q -f "${repo_root}/pom.xml" help:evaluate \
	-Dexpression=project.version -DforceStdout)
cli_version=$(mvn -q -f "${repo_root}/osate-cli/pom.xml" help:evaluate \
	-Dexpression=project.version -DforceStdout)

mkdir -p "${provenance_dir}"
{
	printf 'tooling.commit=%s\n' "${tooling_commit}"
	printf 'tooling.version=%s\n' "${tooling_version}"
	printf 'osate.commit=%s\n' "${actual_osate_sha}"
	printf 'osate.gitlink=%s\n' "${expected_osate_sha}"
	printf 'osate.version=%s\n' "${osate_version}"
	printf 'cli.version=%s\n' "${cli_version}"
	printf 'build.timestamp=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "${provenance_dir}/build-provenance.properties"

echo "Language-server repository:"
echo "  ${repo_root}/aadl-language-server/releng/org.osate.aadl.ls.repository/target/repository"
echo "VS Code extension:"
echo "  ${repo_root}/vscode-extension/aadl2-*.vsix"
echo "CLI distribution:"
echo "  ${repo_root}/osate-cli/dist/target/dist"
echo "Build provenance:"
echo "  ${provenance_dir}/build-provenance.properties"
